def ed_replace(filename: str, search_str: str, replace_with: str, occurrence: int = -1) -> int:
    with open(filename, "r") as file:
        text = file.read()
    """
    it replaces the text in the file with a string

    Args:
    filename: name of file to change
    search_str: Tstring looking for
    replace_with: string that replaces the original with
    occurrence: the occurence that we want to replace
    -1: replaces all of occurrences

    Returns:
    # of replacements made, else it returns 0 if the requested occurrence doesn't exist.
    """

    if search_str == "":
        return 0

    total = text.count(search_str)

    if occurrence == -1:
        changed_text = text.replace(search_str, replace_with)
        replaced = total
    else:
        if occurrence < 0 or occurrence >= total:
            return 0

        position = -1
        search_from = 0
        for _ in range(occurrence + 1):
            position = text.find(search_str, search_from)
            search_from = position + len(search_str)
        changed_text = (
            text[:position] + replace_with + text[position + len(search_str):]
        )
        replaced = 1
    with open(filename, "w") as file:
        file.write(changed_text)
    return replaced

