def ed_read(filename: str, start: int = 0, end: int = -1) -> str:
    """
    Args:
        filename: name of text file 
        start: Where reading begins being 0
        end: Where reading ends being -1 
        reading until the end of the file

    Returns: A string that constains the requested part of the file

    Raises:
        IndexError: if the ending position exceeds the file length
    """

    with open(filename, "r") as file:
        text = file.read()

    length = len(text)

    if end > length:
        raise IndexError("End position exceeds file length")

    if end == -1:
        return text[start:]
    else:
        return text[start:end]

# part b)


def ed_find(filename: str, search_str: str) -> list[int]:
    with open(filename, "r") as file:
        text = file.read()

    """
    Function searches inside a text file for all occurrences of a given string

    Args:
        filename: File name of the file thats being searched
        search_str: text to look for inside the file

    Returns:
        List that contains the starting index of each seperate match. Will return an empty list 
        if it is unable to find any exact matches in the text file
        
    """


    place = []
    places = text.find(search_str)

    while places != -1:
        place.append(places)
        places = text.find(search_str, places + 1)

    return place
